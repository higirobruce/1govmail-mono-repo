generator client {
  provider      = "prisma-client-js"
  // "native" covers dev machines. linux targets cover Docker (glibc + musl/Alpine).
  // darwin targets kept for local development.
  binaryTargets = ["native", "darwin", "darwin-arm64", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Connection is configured via prisma.config.ts using @prisma/adapter-pg.
  // Prisma 7 no longer accepts `url` here — use the driver adapter pattern.
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  displayName  String?
  zimbraHost   String
  authToken    String?
  csrfToken    String?
  tokenExpiry  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions           Session[]
  folders            Folder[]
  messages           Message[]
  contacts           Contact[]
  calendarEvents     CalendarEvent[]
  tasks              Task[]
  snoozedMessages    SnoozedMessage[]
  scheduledMessages  ScheduledMessage[]
  emailTemplates     EmailTemplate[]
  mailRules          MailRule[]
  senderRules        SenderRule[]
  mutedConversations MutedConversation[]
  contactGroups      ContactGroup[]
  notifications      Notification[]
  documents              Document[]
  sentInvites            DocumentInvite[]
  docComments            DocComment[]
  docCommentReactions    DocCommentReaction[]
  docVersionsCreated     DocVersion[]
  docActivity            DocActivity[]
  auditLogs              AuditLog[]
  messageCards           MessageCard[]

  @@map("users")
}

// ─── Audit log ───────────────────────────────────────────────────────────────
// Tamper-resistant append-only record of security-relevant events. Writes
// happen best-effort (never blocks the primary action) but reads are required
// for compliance and incident response.

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  email      String?
  action     String   // LOGIN_SUCCESS | LOGIN_FAILURE | LOGIN_2FA_REQUIRED | LOGOUT | DOC_SHARE_ENABLED | DOC_SHARE_DISABLED | DOC_INVITE_ADDED | DOC_INVITE_REMOVED | SIGNATURE_CHANGED | PASSWORD_CHANGED | PREFS_CHANGED
  resource   String?  // e.g. "document", "signature"
  resourceId String?
  ip         String?
  userAgent  String?
  success    Boolean  @default(true)
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ipAddress  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─── Mail ─────────────────────────────────────────────────────────────────────

model Folder {
  id          String     @id @default(cuid())
  userId      String
  zimbraId    String
  name        String
  path        String
  parentId    String?
  type        FolderType @default(MAIL)
  unreadCount Int        @default(0)
  totalCount  Int        @default(0)
  color       String?
  syncedAt    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userId, zimbraId])
  @@index([userId])
  @@map("folders")
}

enum FolderType {
  MAIL
  CONTACTS
  CALENDAR
  TASKS
  BRIEFCASE
}

model Message {
  id             String    @id @default(cuid())
  userId         String
  folderId       String
  zimbraId       String
  conversationId String?
  subject        String?
  snippet        String?
  bodyText       String?
  bodyHtml       String?
  fromEmail      String
  fromName       String?
  toRecipients   Json
  ccRecipients   Json      @default("[]")
  bccRecipients  Json      @default("[]")
  replyTo        String?
  isRead         Boolean   @default(false)
  isStarred      Boolean   @default(false)
  isDraft        Boolean   @default(false)
  hasAttachments Boolean   @default(false)
  attachments    Json      @default("[]")
  inlineImages   Json?
  // SQLite has no native array type; stored as JSON text (was String[] on PostgreSQL)
  flags          Json      @default("[]")
  tags           Json      @default("[]")
  sentAt         DateTime?
  receivedAt     DateTime
  syncedAt       DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  card   MessageCard?

  @@unique([userId, zimbraId])
  @@index([userId, folderId])
  @@index([userId, conversationId])
  @@map("messages")
}

model MessageCard {
  id                 String   @id @default(cuid())
  messageId          String   @unique
  userId             String
  model              String
  gist               String
  asksOfMe           Json     @default("[]")
  deadlines          Json     @default("[]")
  commitmentsIMade   Json     @default("[]")
  waitingOn          String?
  importance         String   // 'high' | 'normal' | 'low'
  injectionSuspected Boolean  @default(false)
  failed             Boolean  @default(false) // tombstone: extraction gave up; invisible to reads
  extractedAt        DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, extractedAt])
  @@map("message_cards")
}

// ─── Contacts ────────────────────────────────────────────────────────────────

model Contact {
  id        String    @id @default(cuid())
  userId    String
  zimbraId  String
  firstName String?
  lastName  String?
  fullName  String?
  nickname  String?
  company   String?
  jobTitle  String?
  emails    Json      @default("[]")
  phones    Json      @default("[]")
  addresses Json      @default("[]")
  notes     String?
  photoUrl  String?
  // SQLite has no native array type; stored as JSON text (was String[] on PostgreSQL)
  tags      Json      @default("[]")
  syncedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, zimbraId])
  @@index([userId])
  @@map("contacts")
}

// ─── Tasks ───────────────────────────────────────────────────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id              String       @id @default(cuid())
  userId          String
  title           String
  description     String?
  status          TaskStatus   @default(TODO)
  priority        TaskPriority @default(MEDIUM)
  dueDate         DateTime?
  completedAt     DateTime?
  linkedMessageId String?
  linkedSubject   String?
  assignees         Json?    @default("[]") // [{ email: string, name?: string }]
  attachments       Json?
  recurrence        String?
  recurrenceEndDate DateTime?
  reminderAt        DateTime?
  reminderSentAt    DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtasks Subtask[]
  comments TaskComment[]

  @@index([userId])
  @@index([userId, status])
  @@map("tasks")
}

model Subtask {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("subtasks")
}

model TaskComment {
  id          String   @id @default(cuid())
  taskId      String
  userId      String
  authorName  String
  authorEmail String
  body        String
  createdAt   DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_comments")
}

// ─── Mail Features ────────────────────────────────────────────────────────────

model SnoozedMessage {
  id               String   @id @default(cuid())
  userId           String
  messageId        String
  snoozedUntil     DateTime
  originalFolderId String
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([snoozedUntil])
  @@map("snoozed_messages")
}

enum ScheduledMessageStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

model ScheduledMessage {
  id        String                 @id @default(cuid())
  userId    String
  sendAt    DateTime
  to        Json
  cc        Json                   @default("[]")
  bcc       Json                   @default("[]")
  subject   String?
  body      String?
  status    ScheduledMessageStatus @default(PENDING)
  errorMsg  String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, sendAt])
  @@map("scheduled_messages")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  subject   String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_templates")
}

model MailRule {
  id         String   @id @default(cuid())
  userId     String
  name       String
  enabled    Boolean  @default(true)
  // conditions: [{ field: 'from'|'subject'|'to', op: 'contains'|'equals'|'startsWith', value: string }]
  conditions Json
  // actions:    [{ type: 'move'|'markRead'|'star'|'delete', folderId?: string }]
  actions    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mail_rules")
}

enum SenderRuleType {
  BLOCK
  ALLOW
}

model SenderRule {
  id        String         @id @default(cuid())
  userId    String
  type      SenderRuleType
  // Exact address ("person@example.com") or a domain wildcard ("@example.com").
  address   String
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, address])
  @@index([userId])
  @@map("sender_rules")
}

model MutedConversation {
  id             String   @id @default(cuid())
  userId         String
  conversationId String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([userId])
  @@map("muted_conversations")
}

// ─── Contact Groups ───────────────────────────────────────────────────────────

model ContactGroup {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  members     Json     @default("[]") // [{ email: string, name: string }]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("contact_groups")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // MAIL_SNOOZE_EXPIRED | SCHEDULED_SENT | TASK_DUE | EVENT_SOON
  title     String
  body      String?
  isRead    Boolean  @default(false)
  actionUrl String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ─── Docs ─────────────────────────────────────────────────────────────────────

enum SharePermission {
  VIEW
  EDIT
}

model Document {
  id         String   @id @default(cuid())
  userId     String
  title      String   @default("Untitled")
  content    String?  // TipTap JSON stringified
  emoji      String?  // Page icon
  parentId   String?  // Nested pages
  position   Int      @default(0)
  shareToken String?  @unique   // UUID; set when sharing is enabled
  isShared   Boolean  @default(false)
  sharePermission SharePermission @default(VIEW)   // what a share-link holder may do
  yjsState   Bytes?               // Yjs encoded binary state for real-time collaboration
  isFavorite Boolean  @default(false)
  tags       String[] @default([])
  coverColor String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  invites   DocumentInvite[]
  comments  DocComment[]
  versions  DocVersion[]
  activity  DocActivity[]

  @@index([userId])
  @@index([userId, isFavorite])
  @@map("documents")
}

enum InviteRole {
  VIEWER
  EDITOR
}

model DocumentInvite {
  id           String     @id @default(cuid())
  documentId   String
  invitedEmail String
  invitedBy    String
  role         InviteRole @default(EDITOR)
  createdAt    DateTime   @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  inviter  User     @relation(fields: [invitedBy], references: [id], onDelete: Cascade)

  @@unique([documentId, invitedEmail])
  @@index([invitedEmail])
  @@map("document_invites")
}

model DocComment {
  id         String    @id @default(cuid())
  documentId String
  anchorId   String    // UUID matching TipTap mark's data-cid attribute
  content    String
  authorId   String?
  authorName String?
  resolvedAt DateTime?
  parentId   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  document  Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author    User?                @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent    DocComment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   DocComment[]         @relation("CommentReplies")
  reactions DocCommentReaction[]

  @@index([documentId])
  @@index([anchorId])
  @@map("doc_comments")
}

model DocCommentReaction {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  userName  String?
  emoji     String
  createdAt DateTime @default(now())

  comment DocComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([commentId])
  @@map("doc_comment_reactions")
}

model DocVersion {
  id          String   @id @default(cuid())
  documentId  String
  title       String
  content     String
  authorId    String?
  authorName  String?
  createdAt   DateTime @default(now())

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@map("doc_versions")
}

model DocActivity {
  id         String   @id @default(cuid())
  documentId String
  userId     String?
  actorName  String?
  type       String   // VIEWED | EDITED | COMMENTED | RESOLVED | MENTIONED
  meta       Json?
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@map("doc_activity")
}

// ─── Calendar ────────────────────────────────────────────────────────────────

model CalendarEvent {
  id              String   @id @default(cuid())
  userId          String
  zimbraId        String
  zimbraInviteId  String?
  title           String
  description     String?
  location        String?
  startAt         DateTime
  endAt           DateTime
  allDay          Boolean  @default(false)
  isRecurring     Boolean  @default(false)
  recurrenceRule  String?
  organizer       String?
  attendees       Json     @default("[]")
  calendarName    String?
  color           String?
  linkedMessageId String?
  linkedSubject   String?
  syncedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, zimbraId])
  @@index([userId, startAt])
  @@map("calendar_events")
}
