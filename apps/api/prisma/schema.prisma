generator client {
  provider      = "prisma-client-js"
  // "native" covers dev machines. linux targets cover Docker (glibc + musl/Alpine).
  // darwin targets kept for local development.
  binaryTargets = ["native", "darwin", "darwin-arm64", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Connection is configured via prisma.config.ts using @prisma/adapter-pg.
  // Prisma 7 no longer accepts `url` here — use the driver adapter pattern.
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  displayName  String?
  zimbraHost   String
  authToken    String?
  csrfToken    String?
  tokenExpiry  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions           Session[]
  folders            Folder[]
  messages           Message[]
  contacts           Contact[]
  calendarEvents     CalendarEvent[]
  tasks              Task[]
  snoozedMessages    SnoozedMessage[]
  scheduledMessages  ScheduledMessage[]
  emailTemplates     EmailTemplate[]
  mailRules          MailRule[]
  mutedConversations MutedConversation[]
  contactGroups      ContactGroup[]
  notifications      Notification[]
  documents          Document[]
  sentInvites        DocumentInvite[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─── Mail ─────────────────────────────────────────────────────────────────────

model Folder {
  id          String     @id @default(cuid())
  userId      String
  zimbraId    String
  name        String
  path        String
  parentId    String?
  type        FolderType @default(MAIL)
  unreadCount Int        @default(0)
  totalCount  Int        @default(0)
  color       String?
  syncedAt    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userId, zimbraId])
  @@index([userId])
  @@map("folders")
}

enum FolderType {
  MAIL
  CONTACTS
  CALENDAR
  TASKS
  BRIEFCASE
}

model Message {
  id             String    @id @default(cuid())
  userId         String
  folderId       String
  zimbraId       String
  conversationId String?
  subject        String?
  snippet        String?
  bodyText       String?
  bodyHtml       String?
  fromEmail      String
  fromName       String?
  toRecipients   Json
  ccRecipients   Json      @default("[]")
  bccRecipients  Json      @default("[]")
  replyTo        String?
  isRead         Boolean   @default(false)
  isStarred      Boolean   @default(false)
  isDraft        Boolean   @default(false)
  hasAttachments Boolean   @default(false)
  attachments    Json      @default("[]")
  inlineImages   Json?
  // SQLite has no native array type; stored as JSON text (was String[] on PostgreSQL)
  flags          Json      @default("[]")
  tags           Json      @default("[]")
  sentAt         DateTime?
  receivedAt     DateTime
  syncedAt       DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([userId, zimbraId])
  @@index([userId, folderId])
  @@index([userId, conversationId])
  @@map("messages")
}

// ─── Contacts ────────────────────────────────────────────────────────────────

model Contact {
  id        String    @id @default(cuid())
  userId    String
  zimbraId  String
  firstName String?
  lastName  String?
  fullName  String?
  nickname  String?
  company   String?
  jobTitle  String?
  emails    Json      @default("[]")
  phones    Json      @default("[]")
  addresses Json      @default("[]")
  notes     String?
  photoUrl  String?
  // SQLite has no native array type; stored as JSON text (was String[] on PostgreSQL)
  tags      Json      @default("[]")
  syncedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, zimbraId])
  @@index([userId])
  @@map("contacts")
}

// ─── Tasks ───────────────────────────────────────────────────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id              String       @id @default(cuid())
  userId          String
  title           String
  description     String?
  status          TaskStatus   @default(TODO)
  priority        TaskPriority @default(MEDIUM)
  dueDate         DateTime?
  completedAt     DateTime?
  linkedMessageId String?
  linkedSubject   String?
  assignees         Json?    @default("[]") // [{ email: string, name?: string }]
  attachments       Json?
  recurrence        String?
  recurrenceEndDate DateTime?
  reminderAt        DateTime?
  reminderSentAt    DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtasks Subtask[]
  comments TaskComment[]

  @@index([userId])
  @@index([userId, status])
  @@map("tasks")
}

model Subtask {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("subtasks")
}

model TaskComment {
  id          String   @id @default(cuid())
  taskId      String
  userId      String
  authorName  String
  authorEmail String
  body        String
  createdAt   DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_comments")
}

// ─── Mail Features ────────────────────────────────────────────────────────────

model SnoozedMessage {
  id               String   @id @default(cuid())
  userId           String
  messageId        String
  snoozedUntil     DateTime
  originalFolderId String
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([snoozedUntil])
  @@map("snoozed_messages")
}

enum ScheduledMessageStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model ScheduledMessage {
  id        String                 @id @default(cuid())
  userId    String
  sendAt    DateTime
  to        Json
  cc        Json                   @default("[]")
  bcc       Json                   @default("[]")
  subject   String?
  body      String?
  status    ScheduledMessageStatus @default(PENDING)
  errorMsg  String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, sendAt])
  @@map("scheduled_messages")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  subject   String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_templates")
}

model MailRule {
  id         String   @id @default(cuid())
  userId     String
  name       String
  enabled    Boolean  @default(true)
  // conditions: [{ field: 'from'|'subject'|'to', op: 'contains'|'equals'|'startsWith', value: string }]
  conditions Json
  // actions:    [{ type: 'move'|'markRead'|'star'|'delete', folderId?: string }]
  actions    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mail_rules")
}

model MutedConversation {
  id             String   @id @default(cuid())
  userId         String
  conversationId String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([userId])
  @@map("muted_conversations")
}

// ─── Contact Groups ───────────────────────────────────────────────────────────

model ContactGroup {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  members     Json     @default("[]") // [{ email: string, name: string }]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("contact_groups")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // MAIL_SNOOZE_EXPIRED | SCHEDULED_SENT | TASK_DUE | EVENT_SOON
  title     String
  body      String?
  isRead    Boolean  @default(false)
  actionUrl String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ─── Docs ─────────────────────────────────────────────────────────────────────

model Document {
  id         String   @id @default(cuid())
  userId     String
  title      String   @default("Untitled")
  content    String?  // TipTap JSON stringified
  emoji      String?  // Page icon
  parentId   String?  // Nested pages
  position   Int      @default(0)
  shareToken String?  @unique   // UUID; set when sharing is enabled
  isShared   Boolean  @default(false)
  yjsState   Bytes?               // Yjs encoded binary state for real-time collaboration
  isFavorite Boolean  @default(false)
  tags       String[] @default([])
  coverColor String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  invites DocumentInvite[]

  @@index([userId])
  @@index([userId, isFavorite])
  @@map("documents")
}

enum InviteRole {
  VIEWER
  EDITOR
}

model DocumentInvite {
  id           String     @id @default(cuid())
  documentId   String
  invitedEmail String
  invitedBy    String
  role         InviteRole @default(EDITOR)
  createdAt    DateTime   @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  inviter  User     @relation(fields: [invitedBy], references: [id], onDelete: Cascade)

  @@unique([documentId, invitedEmail])
  @@index([invitedEmail])
  @@map("document_invites")
}

// ─── Calendar ────────────────────────────────────────────────────────────────

model CalendarEvent {
  id              String   @id @default(cuid())
  userId          String
  zimbraId        String
  zimbraInviteId  String?
  title           String
  description     String?
  location        String?
  startAt         DateTime
  endAt           DateTime
  allDay          Boolean  @default(false)
  isRecurring     Boolean  @default(false)
  recurrenceRule  String?
  organizer       String?
  attendees       Json     @default("[]")
  calendarName    String?
  color           String?
  linkedMessageId String?
  linkedSubject   String?
  syncedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, zimbraId])
  @@index([userId, startAt])
  @@map("calendar_events")
}
