# 1Gov Mail — Local Environment Variables
# Copy to .env.local before running docker-compose.local.yml
# These are intentionally simple — do NOT use in production.

POSTGRES_PASSWORD=govmail
JWT_SECRET=local_dev_secret_do_not_use_in_production
JWT_EXPIRES_IN=24h
FRONTEND_URL=http://localhost
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_COLLAB_WS_URL=ws://localhost/collab
