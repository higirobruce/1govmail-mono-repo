# ─────────────────────────────────────────────────────────────────────────────
# 1Gov Mail — Production Environment Variables
# Copy this file to .env and fill in all values before running docker compose.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Domain ────────────────────────────────────────────────────────────────────
# The public domain where 1Gov Mail is served.
# DNS A/AAAA record must point to this server on ports 80 and 443.
DOMAIN=mail.yourdomain.gov

# ── HTTPS stage (https-portal) ────────────────────────────────────────────────
# production  → real Let's Encrypt certificates (default)
# staging     → Let's Encrypt staging CA (no rate limits, for testing)
# local       → self-signed certificate (LAN / no public domain)
HTTPS_STAGE=production

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=change_me_strong_password

# ── NestJS API ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_256bit_random_secret

JWT_EXPIRES_IN=8h

# The public URL of the web frontend (used for CORS). Must match DOMAIN above.
FRONTEND_URL=https://mail.yourdomain.gov

# ── EWS / Exchange provider (Phase 3) ────────────────────────────────────────
# REQUIRED if any institution has provider='ews' (e.g. MINAFFET). AES-256-GCM
# key encrypting EWS mailbox credentials at rest in User.authToken — Exchange
# uses NTLM, so the credentials themselves persist (encrypted), not a token.
# Generate with: openssl rand -hex 32  (>= 32 bytes of entropy).
# NEVER reuse JWT_SECRET — a separate secret keeps rotation/leak of one from
# affecting the other. EwsService asserts this at boot: an app with an 'ews'
# institution but no key fails fast at startup (correct, loud failure).
MAIL_CRED_KEY=

# OPTIONAL. Path to a PEM bundle for an internal/private CA, ADDED to EWS TLS
# trust. It can only add trust — it never disables certificate verification.
# MAIL_CA_BUNDLE=/etc/1gov-mail/internal-ca.pem

# NOTE: test-account passwords for the manual EWS smoke pass go in a
# gitignored .env.local — NEVER commit real mailbox credentials to the repo.

# ── Next.js web app (baked into the JS bundle at build time) ─────────────────
# These must match your DOMAIN. Rebuild the web image if they change:
#   docker compose build web && docker compose up -d web
NEXT_PUBLIC_API_URL=https://mail.yourdomain.gov/api
NEXT_PUBLIC_COLLAB_WS_URL=wss://mail.yourdomain.gov/collab

# ── AI backend (Ollama) ──────────────────────────────────────────────────────
# OpenAI-compat root of the Ollama server reachable FROM THE API HOST.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
CARD_MODEL=qwen3-4b-fast:latest
EMBED_MODEL=bge-m3:latest
CHAT_MODEL=qwen3-30b-16k:latest
